{
  // Configuración para lua-language-server (LSP de Lua).
  // Declara los globales inyectados por el runtime de Hyprland
  // para que el LSP no los marque como "undefined global".
  // Más info: https://luals.github.io/wiki/configuration/
  "diagnostics": {
    "globals": [
      "hl" // API de Hyprland, disponible en todos los ficheros de config
    ]
  }
}
